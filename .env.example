# =====================================================================
# Configurações de Ambiente - NexusRedes Infraestrutura
# Renomeie este arquivo para .env e ajuste os valores conforme seu ambiente
# =====================================================================

# Ambiente da Aplicação (development | production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Conexão com o Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=infra_redes
DB_USER=root
DB_PASS=

# Configurações de Segurança e Sessão
SESSION_LIFETIME=3600
CSRF_SECRET_KEY=change_this_to_a_random_32_char_secret_key_123456
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_DECAY_MINUTES=5
